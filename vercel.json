{
  "version": 2,
  "buildCommand": "cd laravel-app && composer install --no-dev --optimize-autoloader --no-interaction",
  "outputDirectory": "laravel-app/public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2",
      "includeFiles": "laravel-app/**"
    }
  },
  "routes": [
    { "src": "/build/(.*)",   "dest": "/laravel-app/public/build/$1" },
    { "src": "/storage/(.*)", "dest": "/laravel-app/public/storage/$1" },
    { "src": "/(.*)",         "dest": "/api/index.php" }
  ]
}
